# ---- RP_COMPILER ----
# Чувствительные данные (пароли, логины, служебные команды)
# в репозиторий не попадают. В каталоге билдера лежат только
# примеры (*.example).

# рабочие конфиги билдера
builder/data/auth.txt
builder/data/support.txt

# фрагмент с макросами CMD (содержит служебные учётные данные)
builder/src/20_macros.inc

# результаты сборки и питоновские артефакты
builder/out/
__pycache__/
*.pyc

# портативный Python -- ставится через FIRST_SETUP.bat
runtime/

# архивы и служебное
*.zip
*.local
.DS_Store
Thumbs.db
